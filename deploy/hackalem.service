[Unit]
Description=HackAlem web app
After=network.target

[Service]
Type=exec
User=hackalem
Group=hackalem
WorkingDirectory=/opt/hackalem/current/backend
Environment=APP_ENV=prod
Environment=DATA_DIR=/var/lib/hackalem
EnvironmentFile=-/etc/hackalem/app.env
ExecStart=/opt/hackalem/current/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8900 --workers 2 --timeout-graceful-shutdown 10
Restart=always
RestartSec=2
SyslogIdentifier=hackalem

# Изоляция и лимиты: сервис делит машину с другими, поэтому при нехватке памяти умирает он первым.
MemoryHigh=900M
MemoryMax=1200M
CPUQuota=200%
TasksMax=256
OOMScoreAdjust=800
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hackalem

[Install]
WantedBy=multi-user.target
