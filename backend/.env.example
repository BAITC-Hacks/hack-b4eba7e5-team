# Скопировать в backend/.env. Без OPENAI_API_KEY бэкенд работает в mock-режиме.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_FALLBACK_MODEL=gpt-5.4                           # запасная модель при 429/5xx/таймауте
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1   # любой OpenAI-совместимый провайдер
# LLM_TIMEOUT_S=60
# LLM_CACHE=false                                       # true — одинаковые запросы отвечаются из кеша
# LLM_MOCK=false
